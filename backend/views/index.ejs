<!DOCTYPE html>
<html>
<head>
  <title>Library</title>
</head>
<body>
  <h1>Library Books</h1>

  <a href="/add">Add New Book</a>

  <ul>
    <% books.forEach(book => { %>
      <li>
        <strong><%= book.title %></strong> by <%= book.author %>

        <% if (book.isBorrowed) { %>
          (Borrowed)
          <form action="/return/<%= book.id %>" method="POST" style="display:inline;">
            <button type="submit">Return</button>
          </form>
        <% } else { %>
          (Available)
          <form action="/borrow/<%= book.id %>" method="POST" style="display:inline;">
            <button type="submit">Borrow</button>
          </form>
        <% } %>
      </li>
    <% }) %>
  </ul>
</body>
</html>